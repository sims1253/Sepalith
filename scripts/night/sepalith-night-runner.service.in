[Unit]
Description=Sepalith nightly GPU window runner (01:00-09:00 Europe/Berlin)
Documentation=file://@REPO@/docs/training/plan-20260927/NIGHT-WINDOW.md

[Service]
Type=exec
ExecStart=@REPO@/scripts/night/night-runner.sh run --max-gpu-used-mib 6144
WorkingDirectory=%h
UMask=0077
# SIGTERM goes to the runner only; it asks the job to save and stop, waits up
# to 45 s, then kills the job's processes and writes the report.
KillMode=mixed
# systemd user services default to a soft limit of 1,024 open files; the trainer needs more.
LimitNOFILE=1048576
TimeoutStopSec=120
# Backstop: the runner itself kills its job at 09:00.
RuntimeMaxSec=9h
