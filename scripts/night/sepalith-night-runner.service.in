[Unit]
Description=Sepalith nightly GPU window runner (00:00-17:00 Europe/Berlin)
Documentation=file://@REPO@/docs/training/plan-20260927/NIGHT-WINDOW.md

[Service]
Type=exec
ExecStart=@REPO@/scripts/night/night-runner.sh run --max-gpu-used-mib 6144 --idle-poll-seconds 300 --notify-command "/usr/bin/python3 -I -B @REPO@/scripts/night/notify-webhook.py"
# If the runner itself dies (bad arguments, crash, kill), wake the orchestrator too; exit 0 and 1 are normal.
ExecStopPost=-@REPO@/scripts/night/night-runner.sh notify-exit
WorkingDirectory=%h
UMask=0077
# SIGTERM goes to the runner only; it asks the job to save and stop, waits up
# to 45 s, then kills the job's processes and writes the report.
KillMode=mixed
# systemd user services default to a soft limit of 1,024 open files; the trainer needs more.
LimitNOFILE=1048576
TimeoutStopSec=120
# Backstop: the runner itself kills its job at 17:00.
RuntimeMaxSec=17h30min
